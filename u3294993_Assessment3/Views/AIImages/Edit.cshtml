@model u3294993_Assessment3.Models.AIImage

@{
    ViewData["Title"] = "Edit AI Image";
}

<section class="upload-section ai-record-page">

    <h1 class="upload-heading">
        Edit AI Image
    </h1>

    <div class="container-fluid">

        <div class="row justify-content-center g-4">

            <!-- Left Side - Edit Form -->
            <div class="col-12 col-md-7">

                <div class="ai-record-panel">

                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>

                        <input type="hidden"
                               asp-for="Id" />

                        <!-- Prompt -->
                        <div class="mb-3">

                            <label asp-for="Prompt"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Prompt"
                                      rows="5"
                                      class="form-control">
                            </textarea>

                            <span asp-validation-for="Prompt"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Image Generator -->
                        <div class="mb-3">

                            <label asp-for="ImageGenerator"
                                   class="form-label">
                            </label>

                            <input asp-for="ImageGenerator"
                                   class="form-control" />

                            <span asp-validation-for="ImageGenerator"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Upload Date - Read Only -->
                        <div class="mb-3">

                            <label asp-for="UploadDate"
                                   class="form-label">
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.UploadDate.ToString("dd/MM/yyyy hh:mm tt")"
                                   readonly />

                        </div>

                        <!-- Likes - Read Only -->
                        <div class="mb-3">

                            <label asp-for="Like"
                                   class="form-label">
                            </label>

                            <input type="number"
                                   class="form-control"
                                   value="@Model.Like"
                                   readonly />

                        </div>

                        <!-- Replace Image -->
                        <div class="mb-3">

                            <label for="imageFile"
                                   class="form-label">

                                Replace Image

                            </label>

                            <input type="file"
                                   name="imageFile"
                                   id="imageFile"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control" />

                            @Html.ValidationMessage(
                                "imageFile",
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        <!-- Actions -->
                        <div class="ai-record-actions">

                            <button type="submit"
                                    class="btn btn-primary">

                                Save

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-light">

                                Back to List

                            </a>

                        </div>

                    </form>

                </div>

            </div>


            <!-- Right Side - Current Uploaded Image -->
            <div class="col-12 col-md-5">

                <div class="ai-record-panel upload-preview">

                    <h2>Current Image</h2>

                    <img src="~/uploads/@Model.Filename"
                         alt="@Model.Prompt"
                         class="img-fluid ai-record-image" />

                </div>

            </div>

        </div>

    </div>

</section>
