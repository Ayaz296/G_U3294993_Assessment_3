@model IEnumerable<u3294993_Assessment3.Models.AIImage>

@{
    ViewData["Title"] = "AI Images";
}

<section class="ai-gallery">

    <div class="ai-gallery-header">
        <h1>AI in Healthcare Gallery</h1>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-controller="AIImages" asp-action="Create">
                Click here to upload a new AI image
            </a>
        }
        else
        {
            <p>
                Please
                <a asp-area="Identity" asp-page="/Account/Login">login</a>
                or
                <a asp-area="Identity" asp-page="/Account/Register">register</a>
                to upload an AI image.
            </p>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="ai-gallery-empty">
            <p>No AI images have been uploaded yet.</p>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <article class="ai-gallery-item" id="image-@item.Id">

                <div class="ai-gallery-image">
                    <img src="@Url.Content("~/uploads/" + item.Filename)"
                         alt="@item.Prompt" />
                </div>

                <div class="ai-gallery-content">
                    <h3>@item.ImageGenerator</h3>

                    <p>@item.Prompt</p>

                    <p class="ai-gallery-date">
                        Uploaded: @item.UploadDate.ToString("dd/MM/yyyy")
                    </p>

                    <div class="ai-gallery-actions">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="AIImages"
                                  asp-action="Like"
                                  asp-route-id="@item.Id"
                                  method="post">
                                <button type="submit" class="btn btn-primary">
                                    Like (@item.Like)
                                </button>
                            </form>
                        }
                        else
                        {
                            <span>Likes: @item.Like</span>
                        }

                        @if (User.IsInRole("admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-success">Edit</a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-danger">Delete</a>
                        }

                    </div>
                </div>

            </article>
        }
    }
</section>
