@model u3294993_Assessment3.Models.AIImage

@{
    ViewData["Title"] = "Delete AI Image";
}

<section class="ai-record-page ai-delete-page">

    <h1 class="upload-heading">
        Delete AI Image
    </h1>

    <h3 class="ai-delete-warning">
        Are you sure you want to delete this image?
    </h3>

    <div class="container-fluid">

        <div class="row justify-content-center g-4">

            <!-- Left Side - Image Details and Actions -->
            <div class="col-12 col-md-7">

                <div class="ai-record-panel">

                    <dl class="row ai-record-details">

                        <!-- Prompt -->
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Prompt)
                        </dt>

                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Prompt)
                        </dd>

                        <!-- Image Generator -->
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.ImageGenerator)
                        </dt>

                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.ImageGenerator)
                        </dd>

                        <!-- Upload Date -->
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.UploadDate)
                        </dt>

                        <dd class="col-sm-8">
                            @Model.UploadDate.ToString("dd/MM/yyyy hh:mm tt")
                        </dd>

                        <!-- Filename -->
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Filename)
                        </dt>

                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Filename)
                        </dd>

                        <!-- Likes -->
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Like)
                        </dt>

                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Like)
                        </dd>

                        <!-- Like Permission -->
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.canIncreaseLike)
                        </dt>

                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.canIncreaseLike)
                        </dd>

                    </dl>

                    <!-- Delete Confirmation -->
                    <form asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="ai-record-actions">

                            <button type="submit"
                                    class="btn btn-danger">

                                Delete

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-light">

                                Back to List

                            </a>

                        </div>

                    </form>

                </div>

            </div>


            <!-- Right Side - Uploaded Image -->
            <div class="col-12 col-md-5">

                <div class="ai-record-panel upload-preview">

                    <h2>Image to Delete</h2>

                    <img src="~/uploads/@Model.Filename"
                         alt="@Model.Prompt"
                         class="img-fluid ai-record-image" />

                </div>

            </div>

        </div>

    </div>

</section>
