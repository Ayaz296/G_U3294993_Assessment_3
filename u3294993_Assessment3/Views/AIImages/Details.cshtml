@model u3294993_Assessment3.Models.AIImage

@{
    ViewData["Title"] = "AI Image Details";
}

<section class="ai-record-page">

    <h1 class="upload-heading">AI Image Details</h1>

    <div class="container-fluid">
        <div class="row justify-content-center g-4">

            @* Left column - Display the details stored in the database *@
            <div class="col-12 col-md-7">
                <div class="ai-record-panel">

                    <dl class="row ai-record-details">

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Prompt)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Prompt)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.ImageGenerator)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.ImageGenerator)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.UploadDate)
                        </dt>
                        <dd class="col-sm-8">
                            @Model.UploadDate.ToString("dd/MM/yyyy hh:mm tt")
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Filename)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Filename)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Like)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Like)
                        </dd>

                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.canIncreaseLike)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.canIncreaseLike)
                        </dd>

                    </dl>

                    @* Navigation to the Edit page and image gallery *@
                    <div class="ai-record-actions">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Edit
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-light">
                            Back to List
                        </a>

                    </div>

                </div>
            </div>

            @* Right column - Display the uploaded image *@
            <div class="col-12 col-md-5">
                <div class="ai-record-panel upload-preview">

                    <h2>Uploaded Image</h2>

                    <img src="@Url.Content("~/uploads/" + Model.Filename)"
                         alt="@Model.Prompt"
                         class="img-fluid ai-record-image" />

                </div>
            </div>

        </div>
    </div>

</section>
