@model u3294993_Assessment3.Models.AIImage

@{
    ViewData["Title"] = "Upload AI Image";
}

<section class="upload-section ai-record-page">

    <h1 class="upload-heading">Upload AI Image</h1>

    <div class="container-fluid">
        <div class="row justify-content-center g-4">

            @* Left side - Image upload form *@
            <div class="col-12 col-md-7">

                <div class="ai-record-panel">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        @* Image prompt *@
                        <div class="mb-3">

                            <label asp-for="Prompt"
                                   class="form-label"></label>

                            <textarea asp-for="Prompt"
                                      rows="5"
                                      class="form-control"></textarea>

                            <span asp-validation-for="Prompt"
                                  class="text-danger"></span>

                        </div>

                        @* Image generator *@
                        <div class="mb-3">

                            <label asp-for="ImageGenerator"
                                   class="form-label"></label>

                            <input asp-for="ImageGenerator"
                                   class="form-control" />

                            <span asp-validation-for="ImageGenerator"
                                  class="text-danger"></span>

                        </div>

                        @* The upload date and likes can't be changed by users *@
                        <div class="mb-3">

                            <label asp-for="UploadDate"
                                   class="form-label"></label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.UploadDate.ToString("dd/MM/yyyy hh:mm tt")"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Like"
                                   class="form-label"></label>

                            <input type="number"
                                   class="form-control"
                                   value="@Model.Like"
                                   readonly />

                        </div>

                        @* Selecting an image to upload *@
                        <div class="mb-3">

                            <label for="imageFile"
                                   class="form-label">
                                Upload Image File
                            </label>

                            <input type="file"
                                   name="imageFile"
                                   id="imageFile"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control"
                                   required />

                            @Html.ValidationMessage(
                                "imageFile",
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                        @* Form buttons *@
                        <div class="ai-record-actions">

                            <button type="submit"
                                    class="btn btn-primary">
                                Create
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-light">
                                Back to List
                            </a>

                        </div>

                    </form>

                </div>

            </div>

            @* Right side - Showing the selected image before uploading *@
            <div class="col-12 col-md-5">

                <div class="ai-record-panel upload-preview">

                    <h2>Image Preview</h2>

                    <p id="previewMessage"
                       class="text-center">
                        Select an image to preview it here.
                    </p>

                    <img id="imagePreview"
                         class="img-fluid ai-record-image d-none"
                         alt="Preview of the selected image" />

                </div>

            </div>

        </div>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
