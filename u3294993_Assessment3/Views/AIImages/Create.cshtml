@model u3294993_Assessment3.Models.AIImage

@{
    ViewData["Title"] = "Upload AI Image";
}

<section class="upload-section">
    <h1 class="upload-heading">Upload AI Image</h1>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Prompt" class="form-label"></label>
                    <textarea asp-for="Prompt" rows="5" class="form-control"></textarea>
                    <span asp-validation-for="Prompt" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageGenerator" class="form-label"></label>
                    <input asp-for="ImageGenerator" class="form-control" />
                    <span asp-validation-for="ImageGenerator" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UploadDate" class="form-label"></label>
                    <input type="text" class="form-control"
                           value="@Model.UploadDate.ToString("dd/MM/yyyy hh:mm tt")"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Like" class="form-label"></label>
                    <input type="number" class="form-control" value="@Model.Like" readonly />
                </div>

                <div class="mb-3">
                    <label for="imageFile" class="form-label">Upload Image File</label>
                    <input type="file" id="imageFile" name="imageFile"
                           accept=".jpg,.jpeg,.png,.webp"
                           class="form-control" required />
                    @Html.ValidationMessage("imageFile", "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-primary">Create</button>

                <div class="mt-3">
                    <a asp-action="Index">Back to List</a>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="upload-preview">
                <h2>Image Preview</h2>
                <img src="~/images/healthcare-preview.jpg"
                     alt="AI in healthcare example"
                     class="img-fluid" />
            </div>
        </div>
    </div>
</section>
