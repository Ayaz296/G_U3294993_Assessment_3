                                MedlinePlus
                            </a>
                        </li>

                        <li>
                            <a href="https://www.healthit.gov/"
                               target="_blank"
                               rel="noopener noreferrer">
                                HealthIT.gov
                            </a>
                        </li>

                        <li>
                            <a href="https://www.cdc.gov/"
                               target="_blank"
                               rel="noopener noreferrer">
                                Centers for Disease Control and Prevention
                            </a>
                        </li>
                    </ul>

                </div>
            </div>

        </div>
    </div>

</section>
