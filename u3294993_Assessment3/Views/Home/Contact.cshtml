@{
    ViewData["Title"] = "Contact & About";
}

<section class="contact-page">

    <h1 class="contact-heading">Contact &amp; About</h1>

    @* Bootstrap creates three equal columns on desktop and stacks them on smaller screens *@
    <div class="container-fluid">
        <div class="row g-4 contact-columns">

            @* Contact information *@
            <div class="col-12 col-md-4">
                <div class="contact-card">

                    <h2>Contact Us</h2>

                    <p>
                        This website was developed by Ayaz Khan
                        as part of the Web Design and Programming
                        unit at the University of Canberra.
                    </p>

                    <p>
                        To get in contact, please email:
                        <a href="mailto:u3294993@uni.canberra.edu.au">
                            u3294993@uni.canberra.edu.au
                        </a>
                    </p>

                </div>
            </div>

            @* Information about the website and technologies used *@
            <div class="col-12 col-md-4">
                <div class="contact-card">

                    <h2>About Us</h2>

                    <p>
                        BioTech AI explores how artificial intelligence
                        can help hospitals and clinics improve patient care,
                        support healthcare professionals and streamline
                        hospital operations.
                    </p>

                    <p>
                        This website was created as part of the assessment
                        requirements for the Web Design and Programming
                        unit at the University of Canberra.
                    </p>

                    <p>
                        The website was developed using ASP.NET Core MVC,
                        C#, HTML5, CSS3, JavaScript and Bootstrap 5,
                        with responsive layouts using Flexbox and Grid.
                    </p>

                </div>
            </div>

            @* Attribution and hyperlinks to external resources *@
            <div class="col-12 col-md-4">
                <div class="contact-card">

                    <h2>Copyright</h2>

                    <p>
                        The AI healthcare images featured on the Home page
                        were generated using ChatGPT.
                    </p>

                    <p>
                        Website icons are provided by
                        <a href="https://fontawesome.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Font Awesome
                        </a>.
                    </p>

                    <p>
                        Website typography uses fonts from
                        <a href="https://fonts.google.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Google Fonts
                        </a>.
                    </p>

                    <p>
                        Information about AI in healthcare was researched
                        using resources from:
                    </p>

                    <ul>
                        <li>
                            <a href="https://www.fda.gov/"
                               target="_blank"
                               rel="noopener noreferrer">
                                U.S. Food and Drug Administration
                            </a>
                        </li>

                        <li>
                            <a href="https://www.who.int/"
                               target="_blank"
                               rel="noopener noreferrer">
                                World Health Organization
                            </a>
                        </li>

                        <li>
                            <a href="https://www.cancer.gov/"
                               target="_blank"
                               rel="noopener noreferrer">
                                National Cancer Institute
                            </a>
                        </li>

                        <li>
                            <a href="https://medlineplus.gov/"
