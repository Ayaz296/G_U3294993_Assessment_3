@model IEnumerable<u3294993_Assessment3.Models.AIImage>

@{
    ViewData["Title"] = "AI in Healthcare";
}

<section class="healthcare-hero">

    <video class="healthcare-hero-video"
           autoplay muted loop playsinline>
        <source src="~/images/2.mp4" type="video/mp4" />
    </video>

    <h1>Healthcare Made Smarter</h1>

    <p>
        Pioneering the future of healthcare through cutting-edge
        AI technologies that redefine how hospitals operate.
    </p>

</section>

<div class="healthcare-parallax">

    <!-- AI-Powered Diagnostics -->

    <section class="healthcare-feature" data-reveal>

        <div class="healthcare-information">
            <h3>AI-Powered Diagnostics</h3>

            <p>
                Our AI-powered diagnostic systems analyse medical images and
                clinical information to identify patterns and abnormalities that can go unnoticed. These tools assist  healthcare professionals
                in making more accurate,faster and informed decisions that can save lives.
            </p>

            <a href="https://www.fda.gov/medical-devices/software-medical-device-samd/artificial-intelligence-enabled-medical-devices">
                Read more
            </a>
        </div>

        <div class="healthcare-media">

            <a href="https://www.fda.gov/medical-devices">
                <figure class="healthcare-image">
                    <img src="~/images/BioTech Path .png"
                         alt="AI-assisted medical imaging" />

                    <figcaption>
                        Our AI assists healthcare professionals in reviewing medical images
                        and identifying areas for further examination.
                    </figcaption>
                </figure>
            </a>

            <a href="https://www.cancer.gov/">
                <figure class="healthcare-image">
                    <img src="~/images/BioTech Path2.png"
                         alt="AI-assisted pathology analysis" />

                    <figcaption>
                        Supports pathology research
                        and the analysis of tissue samples, xrays, scans and many more.
                    </figcaption>
                </figure>
            </a>

        </div>

    </section>

    <!-- Virtual Health Assistants -->

    <section class="healthcare-feature healthcare-feature-reverse" data-reveal>

        <div class="healthcare-information">
            <h3>Virtual Health Assistants</h3>

            <p>
                Virtual health assistants powered by ChatGPT
                to answer general health questions, provide reminders
                and helps professionals by presenting the patient data from multiple hospitals, summarising their medical history and providing key insights.
            </p>

            <a href="https://www.who.int/health-topics/digital-health">
                Read more
            </a>
        </div>

        <div class="healthcare-media">

            <a href="https://www.who.int/health-topics/digital-health">
                <figure class="healthcare-image">
                    <img src="~/images/Healthcare AI 2.png"
                         alt="Virtual healthcare assistant" />

                    <figcaption>
                        Presents patients medical history, their medication, key insights and a database for every scan and report.
                        
                    </figcaption>
                </figure>
            </a>

            <a href="https://medlineplus.gov/">
                <figure class="healthcare-image">
                    <img src="~/images/Healthcare AI.png"
                         alt="Patient using a healthcare chatbot" />

                    <figcaption>
                        Helps doctors log patient data and securely share updated medical records to authorised hospitals.
                    </figcaption>
                </figure>
            </a>

        </div>

    </section>

    <!-- Predictive Analytics -->

    <section class="healthcare-feature" data-reveal>

        <div class="healthcare-information">
            <h3>Predictive Analytics</h3>

            <p>
                Our AI powered monitering systems continuously montier patients vitals in real time and use predicitve analysis to identify abnormal patterns and health complications and alert the healthcare specialists.
            </p>

            <a href="https://www.healthit.gov/">
                Read more
            </a>
        </div>

        <div class="healthcare-media">

            <a href="https://www.healthit.gov/">
                <figure class="healthcare-image">
                    <img src="~/images/Ai monitering.png"
                         alt="Predictive healthcare analytics dashboard" />

                    <figcaption>
                        Alerting and keeping healthcare specialists informed on patient vitals.
                    </figcaption>
                </figure>
            </a>

            <a href="https://www.cdc.gov/">
                <figure class="healthcare-image">
                    <img src="~/images/AI monitering 2.png"
                         alt="Healthcare monitoring and risk analysis" />

                    <figcaption>
                        Our systems take care of patient vitals so that doctors can focus on treating the patient, reducing their workload.
                    </figcaption>
                </figure>
            </a>

        </div>

    </section>

    <!-- Uploaded AI Images -->

    <section class="home-ai-gallery">

        <h2>Upload AI Images</h2>

        <div class="home-ai-upload">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="AIImages"
                   asp-action="Create">
                    Click here to upload a new AI image
                </a>
            }
            else
            {
                <p>
                    Please
                    <a asp-area="Identity"
                       asp-page="/Account/Login">login</a>
                    or
                    <a asp-area="Identity"
                       asp-page="/Account/Register">register</a>
                    to upload your AI images.
                </p>
            }

        </div>

        @if (!Model.Any())
        {
            <p>No images have been uploaded yet.</p>
        }
        else
        {
            <div class="home-ai-grid">

                @foreach (var item in Model)
                {
                    <a asp-controller="AIImages"
                       asp-action="Index"
                       asp-fragment="image-@item.Id"
                       class="home-ai-card">

                        <span class="home-ai-name">
                            @item.ImageGenerator
                        </span>

                        <img src="@Url.Content("~/uploads/" + item.Filename)"
                             alt="@item.Prompt"
                             class="home-ai-image" />

                    </a>
                }

            </div>
        }

    </section>

</div>
