@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    // Pages that already have their own hero or header
    bool hasHero =
        (controller == "Home" &&
        (action == "Index" || action == "Contact" || action == "Helios")) ||
        (controller == "AIImages" && action == "Index");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HealthX</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=Lato&amp;family=Montserrat&amp;family=Niconne&amp;family=Oxygen&amp;display=swap"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Website CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/u3294993_Assessment3.styles.css"
          asp-append-version="true" />
</head>

<body>

    @* Bottom Bar *@
    <div class="bottom-bar">
        <div class="bottom-button-wrapper">
            <a asp-area=""
               asp-controller="AIImages"
               asp-action="Index"
               class="bottom-bar-button">
                <span class="star-icon">✦</span>
                Explore AI Healthcare
            </a>
        </div>
    </div>

    @* Floating Navbar *@
    <header class="healthcare-header">
        <nav class="navbar navbar-expand-sm navbar-dark healthcare-navbar">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    BioTech
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="AIImages"
                               asp-action="Index">
                                AI Images
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Helios">
                                HELIOS
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />
                </div>

            </div>
        </nav>
    </header>

    @* Main Content *@
    <div class="container-fluid healthcare-main @(hasHero ? "p-0" : "healthcare-form-page")">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    
    @* Footer - shared across all pages to avoid repeating the same code, *@
    <footer class="healthcare-footer">
        <div class="container-fluid">

            @* Keep navigation links and icons on one row for a more design matching the Assessment-3 screenshots *@
            <div class="footer-content">
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="AIImages" asp-action="Index">AI Images</a>
                    <a asp-controller="Home" asp-action="Helios">HELIOS</a>
                    <a asp-controller="Home" asp-action="Contact">Contact</a>
                </div>

                @* Quick access icons using the Font Awesome library *@
                <div class="footer-icons">
                    <a asp-controller="Home" asp-action="Index" aria-label="Home">
                        <i class="fa-solid fa-house"></i>
                    </a>

                    <a asp-controller="AIImages" asp-action="Index" aria-label="AI Images">
                        <i class="fa-solid fa-images"></i>
                    </a>

                    <a asp-controller="AIImages" asp-action="Create" aria-label="Upload AI Image">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </a>

                    <a asp-controller="Home" asp-action="Helios" aria-label="HELIOS">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </a>

                    <a asp-controller="Home" asp-action="Contact" aria-label="Contact">
                        <i class="fa-solid fa-envelope"></i>
                    </a>
                </div>
            </div>
            @*Removed the copyright icon, to prevent copyright issues as website is for educational purposes *@
            <p>2026 - BioTech AI</p>

        </div>
    </footer>


    @* JavaScript *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
